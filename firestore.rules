rules_version = '2';

// Правила для Music Roulette (тариф Spark).
// UID ведучого вписаний у isHost(). Після змін опублікуй правила:
// Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isHost() { return signedIn() && request.auth.uid == '5OvTACJrl2aSItlCSCXnGnYjELG2'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function game(g) { return get(/databases/$(database)/documents/games/$(g)).data; }
    function playerDoc(g) { return /databases/$(database)/documents/games/$(g)/players/$(request.auth.uid); }
    function isActivePlayer(g) { return signedIn() && exists(playerDoc(g)) && get(playerDoc(g)).data.status == 'active'; }
    // Новачок посеред гри: уже посаджений ведучим, збирає колоду до старту наступного раунду.
    function isPendingPlayer(g) { return signedIn() && exists(playerDoc(g)) && get(playerDoc(g)).data.status == 'pending'; }

    // Вказівник на активну гру, пул тем, історія: читають усі, пише ведучий.
    match /meta/{id}    { allow read: if true; allow write: if isHost(); }
    match /themes/{id}  { allow read: if true; allow write: if isHost(); }
    match /history/{id} { allow read: if true; allow write: if isHost(); }

    match /games/{g} {
      allow read: if true;
      allow write: if isHost();

      // Заявка на вхід: гравець кладе свій Twitch-токен, ведучий перевіряє і видаляє.
      match /joinRequests/{uid} {
        allow read: if isHost() || isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['token', 'createdAt'])
          && request.resource.data.token is string;
        allow update: if isHost();
        allow delete: if isHost() || isSelf(uid);
      }

      // Гравці: створює ведучий після перевірки. Сам гравець може змінити лише
      // готовність, кількість карт у лобі і здатися (status → 'out', але не назад).
      match /players/{uid} {
        allow read: if true;
        allow create, delete: if isHost();
        allow update: if isHost() || (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready', 'cardCount', 'status'])
          && (request.resource.data.status == resource.data.status || request.resource.data.status == 'out'));
      }

      // Колода видна лише власнику і ведучому. Гравець редагує її в лобі,
      // а новачок посеред гри — поки не сів за стіл.
      match /decks/{uid} {
        allow read: if isHost() || isSelf(uid);
        allow write: if isHost() || (isSelf(uid) && (game(g).phase == 'lobby' || isPendingPlayer(g)));
      }

      // Класичний режим: реєстр треків гри для перевірки дублікатів у лобі.
      // Документ можна лише створити: якщо трек уже взяв інший гравець,
      // запис буде відхилено. У хардкорі реєстр не використовується.
      match /tracks/{key} {
        allow read: if isHost();
        allow create: if ((isActivePlayer(g) && game(g).phase == 'lobby') || isPendingPlayer(g))
          && game(g).settings.mode != 'hardcore'
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;
        allow delete: if isHost() || (signedIn() && resource.data.uid == request.auth.uid);
      }

      // Раунд публічний, але автори в ньому з'являються лише після голосування.
      match /rounds/{n} {
        allow read: if true;
        allow write: if isHost();

        // Хід гравця бачать лише він сам і ведучий.
        match /moves/{uid} {
          allow read: if isHost() || isSelf(uid);
          allow create: if isSelf(uid) && isActivePlayer(g)
            && game(g).phase == 'discard' && string(game(g).round) == n
            && request.resource.data.type in ['discard', 'pass']
            && request.resource.data.cardKey is string;
          allow delete: if isHost();
        }

        // Магазин: заявка на покупку. Створює гравець за столом лише від свого імені;
        // ціну, перевірку і результат (status) пише ведучий.
        match /shop/{id} {
          allow read: if isHost() || (signedIn() && resource.data.uid == request.auth.uid);
          allow create: if isActivePlayer(g) && game(g).phase == 'shop' && string(game(g).round) == n
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'item', 'arg', 'card', 'at'])
            && request.resource.data.item in ['queue', 'swap', 'extraCard', 'double', 'respin'];
          allow update, delete: if isHost();
        }

        // Жетон повторного обертання: гравець просить перекрутити; ведучий перевіряє жетон і час.
        match /respin/{uid} {
          allow read: if isHost() || isSelf(uid);
          allow create, update: if isSelf(uid) && isActivePlayer(g) && game(g).phase == 'spin'
            && request.resource.data.keys().hasOnly(['spinId', 'at']);
          allow delete: if isHost();
        }

        // Тай-брейк: новий трек учасника нічиєї. Ведучий може позначити його відхиленим.
        match /tb/{uid} {
          allow read: if isHost() || isSelf(uid);
          allow create, update: if isHost() || (isSelf(uid) && game(g).phase == 'tbsubmit'
            && request.auth.uid in game(g).tiebreak.tied
            && request.resource.data.keys().hasOnly(['key', 'source', 'id', 'embed', 'url', 'title', 'author', 'start', 'at']));
          allow delete: if isHost();
        }

        // Голос гравця із сайту. Будь-який гравець гри (і вибулий) голосує лише за себе;
        // що він не голосує за свій трек, перевіряє ведучий (знає авторів).
        match /votes/{uid} {
          allow read: if isHost() || isSelf(uid);
          allow create, update: if isSelf(uid) && exists(playerDoc(g))
            && game(g).phase == 'vote' && string(game(g).round) == n
            && request.resource.data.keys().hasOnly(['slot', 'at'])
            && request.resource.data.slot is int
            && request.resource.data.slot >= 1;
          allow delete: if isHost();
        }
      }

      // Хто який трек скинув, до розкриття знає лише ведучий.
      match /secret/{id} { allow read, write: if isHost(); }
    }
  }
}
